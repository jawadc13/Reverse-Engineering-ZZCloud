            VALUE "InternalName", "KaleidoBloom"
            VALUE "OriginalFilename", "KaleidoBloom.scr"
            VALUE "ProductName", "Shader Screensaver Builder"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
