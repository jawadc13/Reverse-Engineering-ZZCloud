#include <windows.h>
#include "resource.h"
#include "common.rc"

IDI_MAIN ICON "julia_drift.ico"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION  "Julia Drift"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "A Julia fractal morphing as its seed wanders"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "JuliaDrift"
            VALUE "OriginalFilename", "JuliaDrift.scr"
            VALUE "ProductName", "Shader Screensaver Builder"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
