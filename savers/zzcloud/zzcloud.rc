    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "zzCloud Screen Saver (remake on the multi-monitor Direct3D 11 framework)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "zzCloud"
            VALUE "OriginalFilename", "zzCloud.scr"
            VALUE "ProductName", "Shader Screensaver Builder"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
