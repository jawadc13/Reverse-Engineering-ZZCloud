#include <windows.h>
#include "resource.h"
#include "common.rc"

IDI_MAIN ICON "zzcloud.ico"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION  "zz Cloud"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
