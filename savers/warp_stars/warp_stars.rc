        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Flying through a field of streaking stars"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "WarpStars"
            VALUE "OriginalFilename", "WarpStars.scr"
            VALUE "ProductName", "Shader Screensaver Builder"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
