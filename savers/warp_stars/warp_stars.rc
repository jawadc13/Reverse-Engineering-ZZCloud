IDI_MAIN ICON "warp_stars.ico"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION  "Warp Stars"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
