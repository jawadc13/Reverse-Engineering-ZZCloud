IDI_MAIN ICON "ring_tunnel.ico"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION  "Ring Tunnel"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Racing down a tunnel of glowing rings"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "RingTunnel"
            VALUE "OriginalFilename", "RingTunnel.scr"
            VALUE "ProductName", "Shader Screensaver Builder"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
