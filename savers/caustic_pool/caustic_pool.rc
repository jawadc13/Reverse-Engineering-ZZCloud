        BEGIN
            VALUE "FileDescription", "Sunlight dancing on the floor of a swimming pool"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "CausticPool"
            VALUE "OriginalFilename", "CausticPool.scr"
            VALUE "ProductName", "Shader Screensaver Builder"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
