        BEGIN
            VALUE "FileDescription", "Out-of-focus city lights drifting past"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "BokehCity"
            VALUE "OriginalFilename", "BokehCity.scr"
            VALUE "ProductName", "Shader Screensaver Builder"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
